<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
  :root {
    /* Sketch / black-and-white palette */
    --page-bg: #ffffff;
    --card-bg: #ffffff;
    --ink: #111111;
    --ink-soft: #444444;
    --muted: #6b6b6b;
    --line: #111111;
    --line-soft: rgba(17, 17, 17, 0.35);
    --panel: #f4f4f4;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--page-bg);
    color: var(--ink);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    line-height: 1.5;
  }

  .wrap {
    max-width: 560px;
    margin: 0 auto;
    padding: 48px 20px 72px;
  }

  header {
    margin-bottom: 36px;
    text-align: left;
    border-bottom: 2px solid var(--line);
    padding-bottom: 32px;
  }

  .eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 700;
    margin-bottom: 10px;
  }

  h1 {
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 28px;
    line-height: 1.3;
    color: var(--ink);
    margin: 0 0 16px;
  }

  .intro {
    font-size: 16px;
    color: var(--ink-soft);
    max-width: 46ch;
  }

  .audience-tag {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    background: #ffffff;
    border: 2px solid var(--line);
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 16px;
  }

  .safety-note {
    margin-top: 20px;
    padding: 14px 16px;
    background: var(--panel);
    border: 2px dashed var(--line);
    border-radius: 12px;
    font-size: 14px;
    color: var(--ink);
  }

  /* ---- Horizontally scrolling example strip ---- */
  .examples-section {
    margin: 0 0 44px;
    padding-top: 28px;
    border-top: 2px solid var(--line);
  }

  .examples-intro {
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 22px;
    line-height: 1.3;
    color: var(--ink);
    margin: 0 0 6px;
  }

  .examples-heading {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 18px;
  }

  .examples-scroll {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 20px;
    -webkit-overflow-scrolling: touch;
    margin: 0 -20px;
    padding: 4px 20px 14px;
  }

  .examples-scroll::-webkit-scrollbar {
    height: 6px;
  }

  .examples-scroll::-webkit-scrollbar-thumb {
    background: var(--line-soft);
    border-radius: 3px;
  }

  .example-card {
    flex: 0 0 190px;
    scroll-snap-align: start;
    background: var(--card-bg);
    border: 2px solid var(--line);
    border-radius: 14px;
    padding: 14px;
    box-shadow: 4px 4px 0 var(--line);
  }

  .example-title {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 13.5px;
    margin: 0 0 6px;
    color: var(--ink);
  }

  .example-desc {
    font-size: 12px;
    color: var(--ink-soft);
    margin: 0;
  }

  .examples-source {
    font-size: 12px;
    color: var(--muted);
    margin: 2px 0 0;
  }

  .examples-source a {
    color: inherit;
  }

  /* ---- Intro / mission section, shown before the resource links ---- */
  .mission-section {
    margin: 0 0 40px;
    padding-top: 28px;
    border-top: 2px solid var(--line);
  }

  .mission-title {
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 24px;
    line-height: 1.3;
    color: var(--ink);
    margin: 0 0 12px;
  }

  .mission-text {
    font-size: 15px;
    color: var(--ink-soft);
    max-width: 48ch;
    margin: 0;
  }

  /* ---- Vertical category cards ---- */
  .cat-stack {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .cat-card {
    background: var(--card-bg);
    border: 2px solid var(--line);
    border-radius: 20px;
    padding: 20px 18px 24px;
    box-shadow: 5px 5px 0 var(--line);
  }

  .cat-body { padding: 0 2px; }

  .cat-label {
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 19px;
    color: var(--ink);
    margin: 0 0 10px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--line);
  }

  .cat-desc {
    font-size: 14.5px;
    color: var(--ink-soft);
    margin: 0 0 16px;
  }

  .cat-desc b { color: var(--ink); }

  .links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  a.link-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    background: #ffffff;
    border: 2px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.15s ease, color 0.15s ease;
  }

  a.link-row:hover,
  a.link-row:focus-visible {
    background: var(--ink);
    color: #ffffff;
  }

  a.link-row:hover .link-title,
  a.link-row:hover .link-desc,
  a.link-row:hover .arrow,
  a.link-row:focus-visible .link-title,
  a.link-row:focus-visible .link-desc,
  a.link-row:focus-visible .arrow {
    color: #ffffff;
  }

  a.link-row:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .link-title { font-weight: 700; font-size: 14.5px; color: var(--ink); }
  .link-desc { font-size: 12.5px; color: var(--muted); margin-top: 2px; }
  .arrow { flex-shrink: 0; color: var(--ink); font-size: 16px; }

  .logos-section {
    margin-top: 48px;
    padding: 24px 20px;
    background: var(--panel);
    border: 2px dashed var(--line);
    border-radius: 18px;
  }

  .logos-label {
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .logos-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .logo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    padding: 0 16px;
    background: #ffffff;
    border: 2px solid var(--line);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  footer {
    margin-top: 32px;
    font-size: 12px;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    a.link-row, .cat-card { transition: none; }
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <h1>Om du er i Norge på grunnlag av familieinnvandring med ektefelle eller samboer, finnes det hjelp for deg.</h1>
    <div class="audience-tag">For deg som er familiegjenforent</div>
    <p class="intro">
      Føles det ikke trygt hjemme? Det finnes hjelp å få — et trygt sted å bo,
      støtte til barna dine, og oppholdstillatelse uavhengig av partneren din.
      Her er en samlet oversikt over pålitelige ressurser for deg.
    </p>
    <div class="safety-note">
      Er du redd for at noen ser hva du søker på? De fleste nettlesere lar deg
      slette søkehistorikken, eller bruke privat/inkognito-vindu.
    </div>
  </header>

  <div class="examples-section">
    <p class="examples-intro">Vold kommer i mange former.</p>
    <div class="examples-heading">Eksempler på vold og overgrep</div>
    <div class="examples-scroll">
      <div class="example-card">
        <h3 class="example-title">Noen gjør kroppen din vondt</h3>
        <p class="example-desc">Sparkes, slås eller holdes fast mot sin vilje.</p>
      </div>
      <div class="example-card">
        <h3 class="example-title">Noen gjør noe seksuelt med deg uten at du vil det</h3>
        <p class="example-desc">Berøring eller sex du ikke har sagt ja til.</p>
      </div>
      <div class="example-card">
        <h3 class="example-title">Noen truer deg på internett eller mobiltelefon</h3>
        <p class="example-desc">Presses til nakenbilder eller trues på nett og mobil.</p>
      </div>
      <div class="example-card">
        <h3 class="example-title">Noen gjør deg redd eller truer deg</h3>
        <p class="example-desc">Skremmes, kalles stygge ting eller trues gjentatte ganger.</p>
      </div>
      <div class="example-card">
        <h3 class="example-title">Noen stjeler fra deg eller lurer deg til å bruke penger</h3>
        <p class="example-desc">Lures for penger eller mister kontroll over egen økonomi.</p>
      </div>
      <div class="example-card">
        <h3 class="example-title">Du får ikke den hjelpen og pleien du trenger</h3>
        <p class="example-desc">Kalles omsorgssvikt — for eksempel manglende mat, hygiene eller helsehjelp.</p>
      </div>
    </div>
    <p class="examples-source">
      Eksempler hentet fra <a href="https://www.bufdir.no/vold/tryggest/utsatt/" target="_blank" rel="noopener">Bufdir.no</a>
    </p>
  </div>

  <div class="mission-section">
    <h2 class="mission-title">Få vite om dine muligheter</h2>
    <p class="mission-text">
      En samlet oversikt over pålitelige ressurser – hjelpetilbud, rettigheter
      og informasjon fra offentlige aktører – tilpasset deg som har kommet til
      Norge gjennom familiegjenforening.
    </p>
  </div>

  <div class="cat-stack">

    <div class="cat-card" id="kjenne-igjen">
      <div class="cat-body">
        <h2 class="cat-label">Å kjenne igjen vold</h2>
        <p class="cat-desc">
          Vold kan være <b>fysisk, psykisk, økonomisk, seksuell eller digital</b>.
          Ofte er det første steget å forstå at det du opplever faktisk har et navn.
        </p>
        <div class="links">
          <a class="link-row" href="https://dinutvei.no/vold-i-naere-relasjoner/" target="_blank" rel="noopener">
            <div>
              <div class="link-title">Hva er vold i nære relasjoner?</div>
              <div class="link-desc">Dinutvei.no — nasjonal veiviser om ulike former for vold</div>
            </div>
            <span class="arrow">→</span>
          </a>
          <a class="link-row" href="https://www.bufdir.no/vold/tryggest/utsatt/" target="_blank" rel="noopener">
            <div>
              <div class="link-title">Er du utsatt for vold?</div>
              <div class="link-desc">Bufdir om kjennetegn på vold og overgrep</div>
            </div>
            <span class="arrow">→</span>
          </a>
          <a class="link-row" href="https://dinutvei.no/negativ-sosial-kontroll-og-aeresrelatert-vold/oppholdstillatelse-vold-menneskehandel/" target="_blank" rel="noopener">
            <div>
              <div class="link-title">Kontroll knyttet til oppholdstillatelse</div>
              <div class="link-desc">Om trusler knyttet til opphold som maktmiddel</div>
            </div>
            <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </div>

    <div class="cat-card" id="akutt-hjelp">
      <div class="cat-body">
        <h2 class="cat-label">Akutt hjelp</h2>
        <p class="cat-desc">
          Er du i fare <b>akkurat nå</b>? Her finner du nødnumre og krisesentre
          som er åpne døgnet rundt.
        </p>
        <div class="links">
          <a class="link-row" href="https://www.politiet.no/rad/vold-i-nare-relasjoner/voldsalarm-og-omvendt-voldsalarm" target="_blank" rel="noopener">
            <div>
              <div class="link-title">Nødnummer 112 og voldsalarm</div>
              <div class="link-desc">Politiet om akutt hjelp og mobil voldsalarm</div>
            </div>
            <span class="arrow">→</span>
          </a>
          <a class="link-row" href="https://www.krisesenter.com/finn-ditt-krisesenter/" target="_blank" rel="noopener">
            <div>
              <div class="link-title">Krisesenter i ditt område</div>
              <div class="link-desc">Gratis, døgnåpent bo- og samtaletilbud i din kommune</div>
            </div>
            <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </div>

    <div class="cat-card" id="rettigheter">
      <div class="cat-body">
        <h2 class="cat-label">Kjenn dine rettigheter</h2>
        <p class="cat-desc">
          Som familiegjenforent har du <b>rettigheter uavhengig av oppholdsgrunnlag</b>.
          Her får du oversikt over hva som gjelder deg.
        </p>
        <div class="links">
          <a class="link-row" href="https://www.udi.no/skal-soke/oppholdstillatelse-for-de-som-har-blitt-mishandlet/" target="_blank" rel="noopener">
            <div>
              <div class="link-title">Opphold ved mishandling</div>
              <div class="link-desc">UDI om selvstendig oppholdstillatelse hvis du er utsatt for vold</div>
            </div>
            <span class="arrow">→</span>
          </a>
          <a class="link-row" href="https://www.statsforvalteren.no/nn/portal/folk-og-samfunn/fri-rettshjelp/" target="_blank" rel="noopener">
            <div>
              <div class="link-title">Gratis rettshjelp</div>
              <div class="link-desc">Statsforvalteren om fri rettshjelp og hvem som kan få det</div>
            </div>
            <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </div>

    <div class="cat-card" id="snakk-med-noen">
      <div class="cat-body">
        <h2 class="cat-label">Snakk med noen</h2>
        <p class="cat-desc">
          Noen ganger er det nok å bare snakke med noen. Disse tjenestene er
          <b>gratis og har taushetsplikt</b>.
        </p>
        <div class="links">
          <a class="link-row" href="https://www.volinjen.no/" target="_blank" rel="noopener">
            <div>
              <div class="link-title">Vold- og overgrepslinjen — 116 006</div>
              <div class="link-desc">Gratis, døgnåpen og anonym hjelpelinje på telefon og chat</div>
            </div>
            <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </div>

  </div>

  <div class="logos-section">
    <div class="logos-label">Et samarbeid mellom</div>
    <div class="logos-row">
      <div class="logo-placeholder">[LOGO: IMDi]</div>
      <div class="logo-placeholder">[LOGO: Bufdir]</div>
      <div class="logo-placeholder">[LOGO: Politiet]</div>
      <div class="logo-placeholder">[LOGO: UDI]</div>
    </div>
  </div>

  <footer>
    Denne siden driftes av INFOVOLD-prosjektet.
  </footer>

</div>
</body>
</html>
